{
  "openapi": "3.1.0",
  "info": {
    "title": "Branch Appointments API",
    "description": "The branch, service catalog, capacity, calendar, staff access, customers, availability, appointments and notifications. Errors are RFC 9457 Problem Details. Updates of existing resources need the resource's ETag in If-Match. Admin endpoints need a sign-in with a second factor.",
    "version": "v1"
  },
  "tags": [
    {
      "name": "Delivery callbacks",
      "description": "Providers report delivered or bounced messages. Signed, no sign-in."
    },
    {
      "name": "Me",
      "description": "The signed-in caller's own access."
    },
    {
      "name": "Branch (public)",
      "description": "Customer endpoints. Only active offerings are returned."
    },
    {
      "name": "Availability",
      "description": "Open times for a service at a branch. No sign-in needed."
    },
    {
      "name": "My customer profile",
      "description": "The signed-in person's own profile, contact details and contact preferences."
    },
    {
      "name": "My appointments",
      "description": "The signed-in customer's own appointments."
    }
  ],
  "paths": {
    "/api/v1/customers/me": {
      "get": {
        "tags": [
          "My customer profile"
        ],
        "summary": "Own profile with its ETag",
        "operationId": "profile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      },
      "put": {
        "tags": [
          "My customer profile"
        ],
        "summary": "Update own name and contact details; an empty email or phone removes it (If-Match)",
        "operationId": "update",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactDetailsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      },
      "post": {
        "tags": [
          "My customer profile"
        ],
        "summary": "Create own profile; links a branch-created profile with the same verified email instead",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      },
      "delete": {
        "tags": [
          "My customer profile"
        ],
        "summary": "Erase own personal data for good; future appointments are cancelled (If-Match)",
        "operationId": "erase",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    },
    "/api/v1/customers/me/contact-preferences": {
      "put": {
        "tags": [
          "My customer profile"
        ],
        "summary": "Change enabled channels and language (If-Match)",
        "operationId": "changePreferences",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactPreferencesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    },
    "/api/v1/webhooks/notifications/{provider}": {
      "post": {
        "tags": [
          "Delivery callbacks"
        ],
        "summary": "Provider callback: delivered or bounced; 401 for an invalid signature",
        "operationId": "callback",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/appointments": {
      "post": {
        "tags": [
          "My appointments"
        ],
        "summary": "Book an open time; a repeat with the same Idempotency-Key returns the first appointment",
        "operationId": "book",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    },
    "/api/v1/appointments/mine/{reference}/reschedule": {
      "post": {
        "tags": [
          "My appointments"
        ],
        "summary": "Move to another open time at the same branch (If-Match); not within the cutoff",
        "operationId": "reschedule",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RescheduleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    },
    "/api/v1/appointments/mine/{reference}/cancel": {
      "post": {
        "tags": [
          "My appointments"
        ],
        "summary": "Cancel (If-Match); not within the cutoff unless the appointment needs rebooking",
        "operationId": "cancel",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    },
    "/api/v1/services": {
      "get": {
        "tags": [
          "Branch (public)"
        ],
        "summary": "List active services, optionally of one category or customer segment, ordered by name",
        "operationId": "services",
        "parameters": [
          {
            "name": "categoryId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "segment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PERSONAL",
                "BUSINESS"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicServiceResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/service-categories": {
      "get": {
        "tags": [
          "Branch (public)"
        ],
        "summary": "List active service categories, optionally of one customer segment, with their active services",
        "operationId": "categories",
        "parameters": [
          {
            "name": "segment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PERSONAL",
                "BUSINESS"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicServiceCategoryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Me"
        ],
        "summary": "Own role, branch IDs, display name if staff, and whether the token is at level 2",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    },
    "/api/v1/branch": {
      "get": {
        "tags": [
          "Branch (public)"
        ],
        "summary": "Get the branch with its hours and offered services",
        "operationId": "branch",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PublicBranchDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/availability": {
      "get": {
        "tags": [
          "Availability"
        ],
        "summary": "Open start times on one day; empty when the branch is closed, 404 if not bookable at all",
        "operationId": "openTimes",
        "parameters": [
          {
            "name": "serviceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/availability/days": {
      "get": {
        "tags": [
          "Availability"
        ],
        "summary": "Dates in a range of at most 31 days that have at least one open time",
        "operationId": "openDays",
        "parameters": [
          {
            "name": "serviceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AvailableDaysResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/appointments/mine": {
      "get": {
        "tags": [
          "My appointments"
        ],
        "summary": "Own appointments, one page at a time: upcoming (not ended yet, soonest first) or past (latest first)",
        "operationId": "mine",
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "upcoming",
              "enum": [
                "upcoming",
                "past"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseAppointmentResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    },
    "/api/v1/appointments/mine/{reference}": {
      "get": {
        "tags": [
          "My appointments"
        ],
        "summary": "One own appointment with its ETag",
        "operationId": "appointment",
        "parameters": [
          {
            "name": "reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "keycloak": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ContactDetailsRequest": {
        "type": "object",
        "properties": {
          "givenName": {
            "type": "string",
            "minLength": 1
          },
          "familyName": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "required": [
          "familyName",
          "givenName"
        ]
      },
      "CustomerResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "givenName": {
            "type": "string"
          },
          "familyName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "emailEnabled": {
            "type": "boolean"
          },
          "smsEnabled": {
            "type": "boolean"
          },
          "language": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DEACTIVATED",
              "ERASED"
            ]
          },
          "linked": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ContactPreferencesRequest": {
        "type": "object",
        "properties": {
          "emailEnabled": {
            "type": "boolean"
          },
          "smsEnabled": {
            "type": "boolean"
          },
          "language": {
            "type": "string"
          }
        },
        "required": [
          "emailEnabled",
          "smsEnabled"
        ]
      },
      "CustomerRequest": {
        "type": "object",
        "properties": {
          "givenName": {
            "type": "string",
            "minLength": 1
          },
          "familyName": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        },
        "required": [
          "familyName",
          "givenName"
        ]
      },
      "BookingRequest": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "serviceId",
          "start"
        ]
      },
      "AppointmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reference": {
            "type": "string"
          },
          "customerId": {
            "type": "string",
            "format": "uuid"
          },
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "type": "string",
            "format": "time-local"
          },
          "endTime": {
            "type": "string",
            "format": "time-local"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "BOOKED",
              "CHECKED_IN",
              "COMPLETED",
              "NO_SHOW",
              "REBOOKING_REQUIRED",
              "CANCELLED"
            ]
          },
          "bookedBy": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "STAFF"
            ]
          },
          "closedReason": {
            "type": "string",
            "enum": [
              "CUSTOMER_CANCELLED",
              "STAFF_CANCELLED",
              "REBOOKING_EXPIRED",
              "CUSTOMER_ERASED"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "RescheduleRequest": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "start"
        ]
      },
      "PublicServiceResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "segment": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "BUSINESS"
            ]
          },
          "description": {
            "type": "string"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultDurationMinutes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PublicServiceCategoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "segment": {
            "type": "string",
            "enum": [
              "PERSONAL",
              "BUSINESS"
            ]
          },
          "description": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicServiceResponse"
            }
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "secondFactor": {
            "type": "boolean"
          }
        }
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string",
            "minLength": 1
          },
          "province": {
            "type": "string",
            "minLength": 1
          },
          "postalCode": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "city",
          "postalCode",
          "province",
          "street"
        ]
      },
      "LocationDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "PublicBranchDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "location": {
            "$ref": "#/components/schemas/LocationDto"
          },
          "timeZone": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "PERSONAL",
                "BUSINESS"
              ]
            },
            "uniqueItems": true
          },
          "weeklyHours": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TimeRangeDto"
              }
            }
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicOfferedService"
            }
          }
        }
      },
      "PublicOfferedService": {
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "segment": {
            "type": "string",
            "enum": [
              "PERSONAL",
