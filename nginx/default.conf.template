# Serves the Angular app and proxies the API (the same split the dev server's proxy.conf.json makes).
# ${BACKEND_URL} is filled in by the nginx image at start-up (envsubst over /etc/nginx/templates).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The backend, as the browser sees it under the app's own origin
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built files have content hashes in their names, so they can be cached for good
    location ~* \.(?:js|css|woff2?|png|jpg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Translations keep their names between releases
    location /i18n/ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Client-side routes (/appointments, /admin/...) all load index.html, which is never cached
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
